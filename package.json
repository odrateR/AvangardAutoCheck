{
  "name": "avangard-autocheck-redesign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 4173",
    "start": "node server.mjs",
    "build": "node generate-pages.mjs",
    "check": "node --check dist/app.js && node --check worker.js && node --check functions/api/contact.js && node --check lib/contact.js && node --check server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.156.0"
  }
}
